# Your personal WhatsApp number — the one that RECEIVES requests and answers YES/NO (digits, with country code)
COACH_WHATSAPP=3706XXXXXXX

# From Meta → WhatsApp → API Setup (the business sender number, NOT your personal one)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Meta app → Settings → Basic → App secret (used to verify webhook signatures)
WHATSAPP_APP_SECRET=
# Any random string; paste the same value into Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=

# Approved template name (see README). Leave empty while testing inside the 24h window.
WHATSAPP_TEMPLATE=lesson_request
WHATSAPP_TEMPLATE_LANG=en

# Approved template that confirms the lesson to the STUDENT (see README). Leave empty to
# get a one-tap link instead, so you can send the confirmation yourself.
WHATSAPP_STUDENT_TEMPLATE=lesson_confirmed
WHATSAPP_STUDENT_TEMPLATE_LANG=en

# Optional: days off, comma separated
BLOCKED_DATES=

# Password for the private dashboard at /admin (choose your own, keep it secret)
ADMIN_PASSWORD=

# Google Drive for video analysis uploads (see README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Lesson voice notes → summary (admin → Players)
# Speech-to-text for voice notes (platform.openai.com → API keys)
OPENAI_API_KEY=
# Claude writes the lesson summary (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=

# AI first draft of video-analysis reports (report builder → "Make AI draft").
# Google AI Studio (aistudio.google.com → Get API key) on a project WITH billing enabled,
# so student videos are not used to train Google's models (free tier data may be).
GEMINI_VIDEO_KEY=
